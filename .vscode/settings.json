{
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "⚡ Quick Build (xelatex × 1)",
            "tools": [
                "xelatex"
            ]
        },
        {
            "name": "📚 Full Build (xelatex → biber → xelatex × 2)",
            "tools": [
                "xelatex",
                "biber",
                "xelatex",
                "xelatex"
            ]
        },
        {
            "name": "pdflatex Quick",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "pdflatex Full (pdflatex → biber → pdflatex × 2)",
            "tools": [
                "pdflatex",
                "biber",
                "pdflatex",
                "pdflatex"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoBuild.recipe.default": "first",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.formatting.latex": "latexindent",
    "[latex]": {
        "editor.formatOnSave": false
    }
}
